{
  "name": "diagram-editor-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Monorepo for diagram editor (web, backend, core library)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:full",
    "dev:full": "concurrently --kill-others \"npm run dev:api\" \"npm run dev:web\"",
    "dev:win": "npm run dev:full",
    "dev:web": "npm run start --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:lib": "npm run dev --workspace=packages/editor-core",
    "build": "npm run build:lib && npm run build:web",
    "build:lib": "npm run build --workspace=packages/editor-core",
    "build:web": "npm run build --workspace=apps/web",
    "start:api": "npm run start --workspace=apps/api",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "publish:lib": "npm run build:lib && npm publish --workspace=packages/editor-core"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^10.0.1",
    "@types/node": "^18.19.129",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "concurrently": "^9.2.1",
    "conventional-changelog-conventionalcommits": "^9.1.0",
    "cross-env": "^10.1.0",
    "semantic-release": "^24.2.9",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "dom-to-image-more": "^3.7.1"
  }
}